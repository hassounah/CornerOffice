{
  "name": "corner-office",
  "version": "0.2.18",
  "description": "CEO-view dashboard over the Corner Office Claude Code plugin ecosystem",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint src && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node scripts/check-bundle.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "keywords": [
    "electron",
    "react",
    "claude",
    "rix"
  ],
  "homepage": "https://corneroffice.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/hassounah/CornerOffice.git"
  },
  "author": {
    "name": "Amer Hassounah",
    "email": "hassounah@gmail.com"
