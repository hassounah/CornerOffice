// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`golden: containerName and argv > createArgv 1`] = `
[
  "create",
  "--name",
  "co-sandbox-my-workspace",
  "--hostname",
  "co-sandbox-my-workspace",
  "--label",
  "co.sandbox=1",
  "--label",
  "co.sandbox.workspace=my-workspace",
  "--label",
  "co.sandbox.agent=claude",
  "--label",
  "co.sandbox.spec=deadbeef",
  "--init",
  "--user",
  "1000:1000",
  "--cap-add",
  "NET_ADMIN",
  "--cap-add",
  "NET_RAW",
  "--security-opt",
  "no-new-privileges",
  "--sysctl",
  "net.ipv4.ip_unprivileged_port_start=1024",
  "--tmpfs",
  "/run:rw,nosuid,nodev,noexec,mode=0755,size=4m",
  "--publish",
  "127.0.0.1:23456:23456",
  "--env",
  "HOME=$HOME",
  "--env",
  "CORNER_OFFICE_SANDBOX=1",
  "--env",
  "CORNER_OFFICE_CHANNEL_PORT=23456",
  "--env",
  "CORNER_OFFICE_BASE_BRANCH=main",
  "--mount",
  "type=bind,source=$HOME/.claude,target=$HOME/.claude",
  "--mount",
  "type=bind,source=$HOME/.corner-office/sandbox/my-workspace/claude-settings.json,target=$HOME/.claude/settings.json,readonly",
  "--mount",
  "type=bind,source=$HOME/.claude/plugins,target=$HOME/.claude/plugins,readonly",
  "--mount",
  "type=bind,source=$HOME/.claude/commands,target=$HOME/.claude/commands,readonly",
  "--mount",
  "type=bind,source=$HOME/.claude/agents,target=$HOME/.claude/agents,readonly",
  "--mount",
  "type=bind,source=$HOME/.claude/skills,target=$HOME/.claude/skills,readonly",
  "--mount",
  "type=bind,source=$HOME/.claude/hooks,target=$HOME/.claude/hooks,readonly",
  "--mount",
  "type=bind,source=$HOME/.claude/CLAUDE.md,target=$HOME/.claude/CLAUDE.md,readonly",
  "--mount",
  "type=bind,source=$HOME/.claude/settings.local.json,target=$HOME/.claude/settings.local.json,readonly",
  "--mount",
  "type=bind,source=$HOME/.corner-office/sandbox/my-workspace/claude-shadow/shell-snapshots,target=$HOME/.claude/shell-snapshots",
  "--mount",
  "type=bind,source=$HOME/.corner-office/sandbox/my-workspace/claude-shadow/session-env,target=$HOME/.claude/session-env",
  "--mount",
  "type=bind,source=$HOME/.corner-office/sandbox/my-workspace/claude-shadow/backups,target=$HOME/.claude/backups",
  "--mount",
  "type=bind,source=$HOME/.corner-office/sandbox/my-workspace/claude-shadow/security,target=$HOME/.claude/security",
  "--mount",
  "type=bind,source=$HOME/.corner-office/sandbox/my-workspace/claude-shadow/ide,target=$HOME/.claude/ide",
  "--mount",
  "type=bind,source=$HOME/.corner-office/sandbox/my-workspace/claude.json,target=$HOME/.claude.json",
  "--mount",
  "type=bind,source=$HOME/.corner-office/sandbox/my-workspace/channels,target=$HOME/.claude/channels",
  "--mount",
  "type=bind,source=$REPO/.git,target=$REPO/.git",
  "--mount",
  "type=bind,source=$REPO/.git/hooks,target=$REPO/.git/hooks,readonly",
  "--mount",
  "type=bind,source=$REPO/.git/config,target=$REPO/.git/config,readonly",
  "--mount",
  "type=bind,source=$REPO/.git/modules,target=$REPO/.git/modules,readonly",
  "--mount",
  "type=bind,source=$REPO/.git/HEAD,target=$REPO/.git/HEAD,readonly",
  "--mount",
  "type=bind,source=$REPO/.git/worktrees/my-workspace/gitdir,target=$REPO/.git/worktrees/my-workspace/gitdir,readonly",
  "--mount",
  "type=bind,source=$REPO/.git/worktrees/my-workspace/commondir,target=$REPO/.git/worktrees/my-workspace/commondir,readonly",
  "--mount",
  "type=bind,source=$HOME/.corner-office/sandboxes/my-workspace,target=$HOME/.corner-office/sandboxes/my-workspace",
  "--mount",
  "type=bind,source=$HOME/.corner-office/sandboxes/my-workspace/.git,target=$HOME/.corner-office/sandboxes/my-workspace/.git,readonly",
  "--mount",
  "type=bind,source=$REPO/.rix,target=$HOME/.corner-office/sandboxes/my-workspace/.rix",
  "--mount",
  "type=bind,source=$HOME/.corner-office/sandbox/my-workspace/events,target=$HOME/.corner-office/events/my-workspace",
  "--mount",
  "type=bind,source=$HOME/.corner-office/events/enabled,target=$HOME/.corner-office/events/enabled,readonly",
  "--workdir",
  "$HOME/.corner-office/sandboxes/my-workspace",
  "claude-sandbox:latest",
]
`;

exports[`golden: containerName and argv > sessionExecArgv for skip and auto, with and without git identity 1`] = `
[
  "exec",
  "--interactive",
  "--tty",
  "--user",
  "1000:1000",
  "--workdir",
  "/wt",
  "--env",
  "TERM=xterm-256color",
  "--env",
  "COLORTERM=truecolor",
  "--env",
  "LANG=C.UTF-8",
  "--env",
  "GIT_AUTHOR_NAME=Ada",
  "--env",
  "GIT_AUTHOR_EMAIL=ada@example.com",
  "--env",
  "GIT_COMMITTER_NAME=Ada",
  "--env",
  "GIT_COMMITTER_EMAIL=ada@example.com",
  "co-sandbox-x",
  "claude",
  "--dangerously-skip-permissions",
  "--dangerously-load-development-channels",
  "plugin:corner-office@amerh",
  "--teammate-mode",
  "in-process",
]
`;

